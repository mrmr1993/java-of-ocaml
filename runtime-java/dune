(executable
 (name embed_class_bytes)
 (modules embed_class_bytes))

(rule
 (targets
  Block.class
  Closure.class
  PartialClosure.class
  CamlException.class
  Compare.class
  Channel.class
  Bytes.class
  Format.class
  Ephemeron.class
  JavaFFI.class
  Mutex.class
  CondVar.class
  BigArray.class)
 (deps
  Block.java
  Closure.java
  PartialClosure.java
  CamlException.java
  Compare.java
  Channel.java
  Bytes.java
  Format.java
  Ephemeron.java
  JavaFFI.java
  Mutex.java
  CondVar.java
  BigArray.java)
 (action
  (run javac -d . %{deps})))

(rule
 (targets runtime_bytes.ml)
 (deps
  (:cls
   Block.class
   Closure.class
   PartialClosure.class
   CamlException.class
   Compare.class
   Channel.class
   Bytes.class
   Format.class
   Ephemeron.class
   JavaFFI.class
   Mutex.class
   CondVar.class
   BigArray.class))
 (action
  (with-stdout-to
   %{targets}
   (run %{dep:embed_class_bytes.exe} %{cls}))))

(library
 (name java_of_ocaml_runtime_bytes)
 (public_name java_of_ocaml.runtime_bytes)
 (modules runtime_bytes))
