(** User-facing FFI for calling into Java code from OCaml.

    The shape of this library mirrors {!Js_of_ocaml.Js}: a single
    phantom-typed universe [Java.t] carries a row type describing the
    Java-visible members, and encoded wrapper types [meth] / [field] /
    [static_meth] / ... record what role each member plays. The PPX
    (ppx_java) turns [obj##meth args] / [obj##.field] / [new%java
    "Class" args] into [external] calls whose primitive names encode
    a caller class, method name, and JVM descriptor; the compiler
    recognises those primitive names and emits direct
    [invokevirtual] / [invokestatic] / [getfield] / [new] sequences.

    For cases the PPX can't reach, {!Unsafe} exposes the building
    blocks directly. *)

(** A reference to a Java object. The type parameter carries the
    Java-visible members as an OCaml object row; this is erased at
    runtime. *)
type +'a t

(** An instance method of type ['a]. On a row type, [foo : int -> bool
    meth] means the Java object has an [int]-arg [bool]-returning
    instance method called [foo]. *)
type +'a meth

(** A static method. *)
type +'a static_meth

(** A readable/writable instance field. *)
type +'a field

(** A [final] or read-only instance field. *)
type +'a readonly_field

(** A static field. *)
type +'a static_field

(** A constructor with the given type. *)
type +'a constr

(** Placeholder for Java's [void] return. In practice, [unit meth] is
    spelled [unit meth] and the generated bytecode pushes [0] after
    the invoke to keep the OCaml-unit shape. *)
type void

(** A Java [String] — same runtime representation as OCaml [string]
    on our JVM backend, so this is just a type alias. *)
type java_string = string

(** A Java object array. *)
type 'a java_array

(** {1 Escape hatch: reflective / dynamic FFI}

    The PPX expands to typed [external]s, but for call sites the PPX
    can't reach (dispatch where the method name is computed at
    runtime, generic dispatch, adapters), these reach the same
    machinery as [Object.getClass().getMethod(name).invoke(args)] at
    runtime. *)
module Unsafe : sig
  (** [meth_call obj name args] invokes instance method [name] on
      [obj] with the given arguments. Resolved reflectively: both
      [name] and the effective descriptor are looked up at runtime.
      Slower than a PPX-expanded call; use when the method is known
      only at runtime. *)
  val meth_call : 'a t -> string -> Obj.t array -> 'b

  val static_meth_call : string -> string -> Obj.t array -> 'b
  val new_obj : string -> Obj.t array -> 'a t
  val get : 'a t -> string -> 'b
  val set : 'a t -> string -> 'b -> unit
  val get_static : string -> string -> 'a
  val set_static : string -> string -> 'a -> unit

  val instanceof : 'a t -> string -> bool
  val checkcast : 'a t -> 'b t

  (** Force the type system to see [x] as an [Obj.t]. Used under the
      hood by the PPX to build [Obj.t array] for [Unsafe.meth_call]
      arguments. *)
  val inject : 'a -> Obj.t
end
