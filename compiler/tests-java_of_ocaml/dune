; Every `<name>.ml` in this directory is an end-to-end smoke test.
; For each one we:
;   1. compile to OCaml bytecode with `ocamlc`,
;   2. run that bytecode with `ocamlrun` and diff stdout against
;      `<name>.expected` (sanity-check for the source program),
;   3. compile the same bytecode to JVM classes with `java_of_ocaml`,
;   4. run the classes with `java` and diff stdout against
;      `<name>.expected` (the actual java_of_ocaml parity check).
;
; All four rules per test are generated into `dune.inc` by
; `gen-rules/gen.exe`. To pick up a newly added `<name>.{ml,expected}`
; pair, run `dune runtest` (it will fail with a diff against the
; regenerated dune.inc) then `dune promote` to accept the change.

(include dune.inc)

(rule
 (deps
  (glob_files *.ml)
  (glob_files *.expected))
 (action
  (with-stdout-to
   dune.inc.gen
   (run gen-rules/gen.exe))))

(rule
 (alias runtest)
 (action
  (diff dune.inc dune.inc.gen)))
